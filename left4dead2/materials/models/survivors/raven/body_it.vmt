"VertexLitGeneric"
{
	"$basetexture" 					"models/survivors/raven/body"
	"$bumpmap" 						"models/survivors/raven/bile_normal"
	$phongexponenttexture		"dev/reflectivity_90b"
	
	"$phong" 			"1"
	"$phongexponent" 			"46"
	"$phongboost" 			"1"
	"$phongfresnelranges" 		"[6 2 1]"
	"$phongalbedotint" 			"1"

	"$nodecal" 		1
	
	$emissiveBlendEnabled 				"1"
	
	$emissiveBlendFlowTexture		"vgui/white" //Flow from Green to Red. Yellow = still
	$emissiveBlendTexture		"vgui/white" //The texture that the flowmap scrolls. Not mapped to a UV
	$emissiveBlendBaseTexture		"models/survivors/raven/body_e" //The texture used for the self-illumination. Can be colored or grayscale. Does not adopt the base texture's color
	
	$emissiveBlendTint 			"[1 1 1]"
	$emissiveBlendStrength 		"0.35"
	$emissiveBlendScrollVector 		"[0.0 0.0]" 
	
	$bussin   9
	
	$detail "models\survivors\survivor_it"
	$detailscale 1.75
	$detailblendfactor ".001" 
	$detailblendmode 0

	$ITAmount 0
	 

	Proxies
	{
		IT
		{
		resultVar $ITAmount
		}
		Equals
		{
		srcVar1 $ITAmount
		resultVar $detailblendfactor
		}
		Multiply
		{
		srcVar1	$bussin
		srcVar2	$ITAmount
		resultVar	$phongboost
		}
	}
}

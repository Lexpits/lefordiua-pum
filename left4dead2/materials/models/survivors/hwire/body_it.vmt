"VertexLitGeneric"
{
	"$basetexture" 					"models/survivors/hwire/body"
	"$bumpmap" 					"models/survivors/hwire/bile_normal"
	"$phongexponenttexture"	"dev/reflectivity_90b"
 
	$phong 								"1"
	$phongexponent 					"56"
	$phongboost 						"5"
	$phongfresnelranges 			"[6 2 1]"
	$phongalbedotint 				"1"
	
	$halflambert						"1"
	$nodecal								"1"
	$nocull								"1"
	
	$bussin   15
	
	$detail "models\survivors\survivor_it"
	$detailscale 1.75
	$detailblendfactor ".001" 
	$detailblendmode 0

	$ITAmount 0

	Proxies
	{
		IT
		{
		resultVar $ITAmount
		}
		Equals
		{
		srcVar1 $ITAmount
		resultVar $detailblendfactor
		}
		Multiply
		{
		srcVar1	$bussin
		srcVar2	$ITAmount
		resultVar	$phongboost
		}
	}
}
